#!/usr/bin/env bash
set -euo pipefail

DOTS="$HOME/dotfiles"
CS="$DOTS/colorscheme"

themes() {
  for file in "$CS"/*/ghostty.conf; do
    local name
    name="$(basename "$(dirname "$file")")"
    [ "$name" = current ] || echo "$name"
  done
}

current() {
  basename "$(readlink "$CS/current" 2>/dev/null || echo rose-pine)"
}

status() {
  echo "current: $(current)"
  echo "themes : $(themes | paste -sd ' ' -)"
}

apply() {
  local name="$1"
  if [ ! -f "$CS/$name/ghostty.conf" ]; then
    echo "unknown theme: $name" >&2
    status >&2
    exit 1
  fi

  ln -sfn "$name" "$CS/current"
  touch "$DOTS/.wezterm.lua"

  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    tmux source-file "$CS/tmux.conf" >/dev/null 2>&1 || true
  fi

  echo "→ $name"
  echo "  wezterm·tmux 즉시 반영 · nvim 창 포커스 시 반영 · ghostty ⌘⇧,"
}

case "${1:-status}" in
  status)
    status
    ;;
  -h|--help)
    echo "usage: theme [name|status]"
    status
    ;;
  *)
    apply "$1"
    ;;
esac
